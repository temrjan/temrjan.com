---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Contact from '@/components/Contact.astro';
import { CAPABILITIES_URL, CASE_SOURCES, MERGED_PULL_REQUESTS } from '@/data/cases';
import { SUPPORTED_LANGS, type Language } from '@/i18n/config';
import { getCopy } from '@/i18n/utils';

export function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const copy = getCopy(lang);
---

<BaseLayout lang={lang} section="services">
  <Header lang={lang} section="services" />
  <main id="main" class="shell page-main services-page">
    <header class="page-intro">
      <p class="eyebrow">{copy.services.eyebrow}</p>
      <h1>{copy.services.title}</h1>
      <p class="page-lead">{copy.services.lead}</p>
    </header>

    <section class="section-block" aria-labelledby="directions-heading">
      <div class="section-heading"><span class="section-number">01</span><h2 id="directions-heading">{copy.services.directionsTitle}</h2></div>
      <div class="direction-grid">
        {copy.services.directions.map((item, index) => (
          <article class="direction-card">
            <span class="card-number">0{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block" aria-labelledby="cases-heading">
      <div class="section-heading"><span class="section-number">02</span><h2 id="cases-heading">{copy.services.casesTitle}</h2></div>
      <p class="section-intro">{copy.services.casesIntro}</p>
      <div class="case-grid">
        {copy.services.cases.map((item, index) => (
          <article class="case-card">
            <div class="case-card-top"><span class="card-number">0{index + 1} / 03</span><span class="case-status">{item.status}</span></div>
            <h3>{item.title}</h3>
            <dl>
              <div><dt>{copy.services.caseChallenge}</dt><dd>{item.challenge}</dd></div>
              <div><dt>{copy.services.caseContribution}</dt><dd>{item.contribution}</dd></div>
              <div><dt>{copy.services.caseStatus}</dt><dd>{item.status}</dd></div>
            </dl>
            <a class="text-link" href={CASE_SOURCES[index].href} target="_blank" rel="noopener noreferrer">
              {copy.common.source}: {CASE_SOURCES[index].name} <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
      <a class="catalog-link" href={CAPABILITIES_URL} target="_blank" rel="noopener noreferrer">{copy.common.fullCatalog} <span aria-hidden="true">↗</span></a>
    </section>

    <section class="section-block" aria-labelledby="process-heading">
      <div class="section-heading"><span class="section-number">03</span><h2 id="process-heading">{copy.services.processTitle}</h2></div>
      <ol class="process-grid">
        {copy.services.steps.map((item, index) => (
          <li><span class="card-number">0{index + 1}</span><h3>{item.title}</h3><p>{item.detail}</p></li>
        ))}
      </ol>
    </section>

    <section class="evidence-block" aria-labelledby="evidence-heading">
      <h2 id="evidence-heading">{copy.services.evidenceTitle}</h2>
      <p>{copy.services.evidenceText}</p>
      <ul>
        {MERGED_PULL_REQUESTS.map((pr) => (
          <li><a href={pr.href} target="_blank" rel="noopener noreferrer">{pr.name} <span aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
    </section>

    <Contact lang={lang} title={copy.services.ctaTitle} text={copy.services.ctaText} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
