---
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileMenu from './MobileMenu.astro';
import { sectionPath, type Language, type Section } from '@/i18n/config';
import { getCopy } from '@/i18n/utils';

interface Props {
  lang: Language;
  section: Section;
}

const { lang, section } = Astro.props;
const copy = getCopy(lang);
const sections: Section[] = ['home', 'resume', 'services'];
const name = lang === 'ru' ? 'Темржан Хасенов' : 'Temrjan Khasenov';
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={sectionPath(lang, 'home')}>
      <span class="brand-mark" aria-hidden="true">T</span>
      <span>{name}</span>
    </a>
    <nav class="desktop-nav" aria-label={copy.nav.menu}>
      {sections.map((item) => (
        <a href={sectionPath(lang, item)} aria-current={item === section ? 'page' : undefined}>
          {copy.nav[item]}
        </a>
      ))}
    </nav>
    <div class="desktop-language"><LanguageSwitcher lang={lang} section={section} /></div>
    <MobileMenu lang={lang} section={section} />
  </div>
</header>
