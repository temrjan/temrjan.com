---
import type { Language } from '@/i18n/config';
import { getCopy } from '@/i18n/utils';

interface Props {
  lang: Language;
  title?: string;
  text?: string;
}

const { lang, title, text } = Astro.props;
const copy = getCopy(lang);
---

<section class="contact-panel" id="contact" aria-labelledby="contact-heading">
  <div>
    <p class="eyebrow">{copy.common.contact}</p>
    <h2 id="contact-heading">{title ?? copy.common.contact}</h2>
    {text && <p class="contact-intro">{text}</p>}
  </div>
  <div class="contact-actions">
    <a class="button button-primary" href="https://t.me/temrjan" target="_blank" rel="noopener noreferrer">{copy.common.telegram} ↗</a>
    <a class="button button-outline" href="mailto:x.temrjan@gmail.com">{copy.common.email} ↗</a>
    <a class="button button-outline" href="https://github.com/temrjan" target="_blank" rel="noopener noreferrer">{copy.common.github} ↗</a>
  </div>
</section>
