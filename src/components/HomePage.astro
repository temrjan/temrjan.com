---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Contact from './Contact.astro';
import { sectionPath, type Language } from '@/i18n/config';
import { getCopy } from '@/i18n/utils';

interface Props {
  lang: Language;
  isRoot?: boolean;
}

const { lang, isRoot = false } = Astro.props;
const copy = getCopy(lang);
const name = lang === 'ru' ? 'Темржан Хасенов' : 'Temrjan Khasenov';
---

<BaseLayout lang={lang} section="home" isRoot={isRoot}>
  <Header lang={lang} section="home" />
  <main id="main" class="shell">
    <section class="home-hero" aria-labelledby="home-heading">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span>{copy.home.eyebrow}</p>
        <h1 id="home-heading">{name}<span class="period">.</span></h1>
        <p class="hero-intro">{copy.home.intro}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={sectionPath(lang, 'resume')}>{copy.home.resumeLink} <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href={sectionPath(lang, 'services')}>{copy.home.servicesLink} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="hero-aside" aria-label={copy.home.currentLabel}>
        <div class="aside-top"><span class="status-dot" aria-hidden="true"></span>{copy.common.availability}</div>
        <div class="aside-block">
          <span class="small-label">{copy.home.currentLabel}</span>
          <p>{copy.home.currentText}</p>
        </div>
        <div class="aside-block">
          <span class="small-label">{copy.home.focusLabel}</span>
          <p>{copy.home.focusText}</p>
        </div>
        <span class="aside-location">{copy.common.location}</span>
      </aside>
    </section>

    <section class="feature-strip" aria-labelledby="selected-heading">
      <div>
        <p class="eyebrow">01 / 03</p>
        <h2 id="selected-heading">{copy.home.selectedTitle}</h2>
        <p>{copy.home.selectedText}</p>
      </div>
      <a class="text-link" href={sectionPath(lang, 'services')}>{copy.nav.services} <span aria-hidden="true">↗</span></a>
    </section>

    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
