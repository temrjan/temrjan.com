---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { sectionPath, type Language, type Section } from '@/i18n/config';
import { getCopy } from '@/i18n/utils';

interface Props {
  lang: Language;
  section: Section;
}

const { lang, section } = Astro.props;
const copy = getCopy(lang);
const sections: Section[] = ['home', 'resume', 'services'];
---

<details class="mobile-menu">
  <summary>{copy.nav.menu}<span aria-hidden="true">☰</span></summary>
  <div class="mobile-menu-panel">
    <nav aria-label={copy.nav.menu}>
      {sections.map((item) => (
        <a href={sectionPath(lang, item)} aria-current={item === section ? 'page' : undefined}>
          {copy.nav[item]}
        </a>
      ))}
    </nav>
    <LanguageSwitcher lang={lang} section={section} />
  </div>
</details>
