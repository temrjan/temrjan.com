---
import { LANGUAGE_LABELS, SUPPORTED_LANGS, sectionPath, type Language, type Section } from '@/i18n/config';
import { getCopy } from '@/i18n/utils';

interface Props {
  lang: Language;
  section: Section;
}

const { lang, section } = Astro.props;
const copy = getCopy(lang);
---

<nav class="language-switch" aria-label={copy.nav.language}>
  {SUPPORTED_LANGS.map((language) => (
    <a
      href={sectionPath(language, section)}
      lang={language}
      hreflang={language}
      aria-current={language === lang ? 'page' : undefined}
    >{LANGUAGE_LABELS[language]}</a>
  ))}
</nav>
