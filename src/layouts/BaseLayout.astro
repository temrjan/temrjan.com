---
import '@/styles/global.css';
import { SUPPORTED_LANGS, sectionPath, type Language, type Section } from '@/i18n/config';
import { getCopy } from '@/i18n/utils';

interface Props {
  lang: Language;
  section: Section;
  isRoot?: boolean;
}

const { lang, section, isRoot = false } = Astro.props;
const copy = getCopy(lang);
const { title, description } = copy.meta[section];
const base = Astro.site ?? new URL('https://temrjan.com');
const absolute = (path: string) => new URL(path, base).href;
const canonical = absolute(sectionPath(lang, section));
const defaultPath = section === 'home' ? '/' : sectionPath('en', section);
const locale = { en: 'en_US', ru: 'ru_RU', uz: 'uz_UZ' }[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {SUPPORTED_LANGS.map((language) => (
      <link rel="alternate" hreflang={language} href={absolute(sectionPath(language, section))} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absolute(defaultPath)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={isRoot ? absolute('/') : canonical} />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f7f8f5" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: lang === 'ru' ? 'Темржан Хасенов' : 'Temrjan Khasenov',
      url: 'https://temrjan.com/',
      jobTitle: 'Fullstack AI Developer',
      sameAs: ['https://github.com/temrjan', 'https://t.me/temrjan'],
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.common.skip}</a>
    <slot />
  </body>
</html>
